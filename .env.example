# Copy this file to .env and fill it in. The shop server (server/) reads it.

# Public site address used as the Instamojo return URL (no trailing slash).
# Local: http://localhost:5173
# Live:  https://your-domain.com
SHOP_PUBLIC_URL=http://localhost:5173

# Instamojo API credentials (Dashboard → API & Plugins / Developers).
# These create a fresh payment for the product price and verify it before
# showing the thank-you card + Canva template.
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=

# Razorpay API keys (optional alternative). From Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# What a buyer receives, one line per product: TEMPLATE_URL_ + the product id from
# src/shop/catalog.js in capitals. Only handed over after a confirmed payment.
# Use a Canva "Template link" (Share → Template link), not an /edit link.
TEMPLATE_URL_SWEET_SEVENTEEN=
